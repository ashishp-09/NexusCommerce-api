{
  "openapi": "3.0.3",
  "info": {
    "title": "NexusCommerce REST API",
    "description": "High-performance, modular enterprise e-commerce backend built with TypeScript, Express, Prisma ORM, Redis caching, and Stripe payments.",
    "version": "1.2.0",
    "contact": {
      "name": "NexusCommerce Engineering Team",
      "url": "https://nexuscommerce.io"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.nexuscommerce.io/api/v1",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service Health Check",
        "responses": {
          "200": { "description": "Server is healthy and operational" }
        }
      }
    },
    "/health/detailed": {
      "get": {
        "summary": "Detailed System Diagnostics",
        "responses": {
          "200": { "description": "Diagnostic telemetry metrics" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register New User",
        "responses": {
          "201": { "description": "User created successfully" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User Login",
        "responses": {
          "200": { "description": "Authentication successful" }
        }
      }
    },
    "/product": {
      "get": {
        "summary": "Get Paginated Product Catalog",
        "responses": {
          "200": { "description": "Products retrieved successfully" }
        }
      }
    },
    "/product/search/suggestions": {
      "get": {
        "summary": "Search Autocomplete Suggestions",
        "responses": {
          "200": { "description": "Typeahead suggestions list" }
        }
      }
    },
    "/product/facets": {
      "get": {
        "summary": "Catalog Facet Aggregations",
        "responses": {
          "200": { "description": "Category item counts and price boundaries" }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "Get User Cart",
        "responses": {
          "200": { "description": "Current cart with item totals and subtotal" }
        }
      }
    },
    "/wishlist": {
      "get": {
        "summary": "Get Customer Wishlist",
        "responses": {
          "200": { "description": "User saved wishlist items" }
        }
      }
    },
    "/address": {
      "get": {
        "summary": "Get User Address Book",
        "responses": {
          "200": { "description": "List of saved shipping addresses" }
        }
      },
      "post": {
        "summary": "Add New Address",
        "responses": {
          "201": { "description": "Address created" }
        }
      }
    },
    "/address/default": {
      "get": {
        "summary": "Get Default Shipping Address",
        "responses": {
          "200": { "description": "Default address" }
        }
      }
    },
    "/inventory/low-stock": {
      "get": {
        "summary": "Admin Low Stock Alert",
        "responses": {
          "200": { "description": "List of products below stock threshold" }
        }
      }
    },
    "/inventory/restock": {
      "patch": {
        "summary": "Restock Product Inventory",
        "responses": {
          "200": { "description": "Product stock replenished" }
        }
      }
    },
    "/coupons": {
      "get": {
        "summary": "List Available Coupons & Promotions",
        "responses": {
          "200": { "description": "Active promotional coupons" }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create Order from Cart",
        "responses": {
          "201": { "description": "Order created" }
        }
      }
    },
    "/payment/checkout": {
      "post": {
        "summary": "Create Stripe Checkout Session",
        "responses": {
          "200": { "description": "Stripe checkout URL and session ID" }
        }
      }
    }
  }
}
